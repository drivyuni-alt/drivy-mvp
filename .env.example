# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Conexion Postgres para aplicar migraciones (Session pooler, puerto 5432).
# Solo local: la app no la usa y no va en Vercel. La conexion directa
# db.<ref>.supabase.co NO sirve, solo resuelve por IPv6.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-1-eu-west-2.pooler.supabase.com:5432/postgres

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Stripe (arquitectura preparada, sin claves reales todavia)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
